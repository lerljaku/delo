{
  "manifest_version": 3,
  "name": "mtgdelo: upload from Eventlink",
  "version": "0.1.4",
  "description": "Uploads the results of an Eventlink tournament to mtgdelo.com in one click.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Upload this Eventlink event to mtgdelo",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://mtgdelo.com/*", "http://localhost/*", "http://127.0.0.1/*"]
}
